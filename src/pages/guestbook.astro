---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="방명록" description="조연재에게 남기는 방명록. 궁금한 점이나 함께하고 싶은 일을 남겨 주세요.">
  <PageIntro
    label="Guestbook"
    title="방명록"
    lead="궁금한 점이나 함께하고 싶은 일이 있다면 편하게 남겨 주세요. 확인하고 답장드릴게요."
  />

  <div class="layout">
    <form class="form" data-gb-form novalidate>
      <div class="field">
        <label for="gb-name">이름 <span class="req" aria-hidden="true">*</span></label>
        <input id="gb-name" name="name" type="text" maxlength="30" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="gb-contact">연락처 <span class="caption">(선택)</span></label>
        <input id="gb-contact" name="contact" type="text" maxlength="100" autocomplete="email" placeholder="이메일, 전화번호, SNS 등" aria-describedby="gb-contact-hint" />
        <p class="hint" id="gb-contact-hint">연락처는 저에게만 보여요.</p>
      </div>
      <div class="field">
        <label for="gb-message">메시지 <span class="req" aria-hidden="true">*</span></label>
        <textarea id="gb-message" name="message" rows="6" maxlength="1000" required aria-describedby="gb-count"></textarea>
        <p class="hint count" id="gb-count" aria-live="polite">0 / 1000</p>
      </div>
      <!-- 스팸 봇 함정: 사람에게는 보이지 않는다 -->
      <div class="trap" aria-hidden="true">
        <label for="gb-website">웹사이트</label>
        <input id="gb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label class="check" for="gb-public">
        <input id="gb-public" name="isPublic" type="checkbox" />
        <span class="box" aria-hidden="true"></span>
        <span>다른 방문자에게도 이 글 보이기 <span class="caption">(선택하지 않으면 저만 봐요)</span></span>
      </label>
      <div class="actions">
        <button type="submit" class="submit">남기기</button>
        <p class="status" role="status" aria-live="polite" data-gb-status></p>
      </div>
    </form>

    <section class="board" aria-labelledby="gb-list-title">
      <h2 class="pixel-label" id="gb-list-title">Messages</h2>
      <p class="caption" data-gb-empty hidden>아직 공개된 글이 없어요.</p>
      <p class="caption" data-gb-offline hidden>
        방명록을 준비하고 있어요. 급한 연락은 <a href={`mailto:${SITE.email}`}>{SITE.email}</a> 로 주세요.
      </p>
      <ol class="entries" data-gb-list></ol>
    </section>
  </div>

  <template id="gb-entry">
    <li class="entry">
      <p class="meta"><span class="who"></span><time class="pixel-label"></time></p>
      <p class="msg"></p>
      <div class="reply" hidden>
        <p class="pixel-label">Reply</p>
        <p class="reply-msg"></p>
      </div>
    </li>
  </template>
</BaseLayout>

<script>
  const fmt = (t: number) => {
    const d = new Date(t);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}.${p(d.getMonth() + 1)}.${p(d.getDate())}`;
  };
  type Entry = { id: string; name: string; message: string; createdAt: number; reply?: string };

  function render(list: HTMLElement, entries: Entry[]) {
    const tpl = document.getElementById('gb-entry') as HTMLTemplateElement;
    list.replaceChildren(
      ...entries.map((e) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        li.querySelector('.who')!.textContent = e.name;
        const time = li.querySelector('time')!;
        time.textContent = fmt(e.createdAt);
        time.dateTime = new Date(e.createdAt).toISOString();
        li.querySelector('.msg')!.textContent = e.message; // 글은 항상 텍스트로만 넣는다
        if (e.reply) {
          (li.querySelector('.reply') as HTMLElement).hidden = false;
          li.querySelector('.reply-msg')!.textContent = e.reply;
        }
        return li;
      }),
    );
  }

  async function setup() {
    const form = document.querySelector<HTMLFormElement>('[data-gb-form]');
    if (!form) return;
    const list = document.querySelector<HTMLElement>('[data-gb-list]')!;
    const empty = document.querySelector<HTMLElement>('[data-gb-empty]')!;
    const offline = document.querySelector<HTMLElement>('[data-gb-offline]')!;
    const status = document.querySelector<HTMLElement>('[data-gb-status]')!;
    const msg = form.querySelector<HTMLTextAreaElement>('#gb-message')!;
    const count = form.querySelector<HTMLElement>('#gb-count')!;
    msg.addEventListener('input', () => (count.textContent = `${msg.value.length} / 1000`));

    let entries: Entry[] = [];
    const load = async () => {
      try {
        const res = await fetch('/api/guestbook', { headers: { accept: 'application/json' } });
        if (res.status === 503) throw new Error('offline');
        const data = await res.json();
        entries = (data.entries as (Entry & { isPublic?: boolean })[]).filter((e) => e.isPublic !== false);
        render(list, entries);
        empty.hidden = entries.length > 0;
        offline.hidden = true;
      } catch {
        offline.hidden = false;
        empty.hidden = true;
      }
    };
    load();

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      const body = {
        name: String(fd.get('name') ?? ''),
        contact: String(fd.get('contact') ?? ''),
        message: String(fd.get('message') ?? ''),
        website: String(fd.get('website') ?? ''),
        isPublic: fd.get('isPublic') === 'on',
      };
      if (!body.name.trim()) return void ((status.textContent = '이름을 적어 주세요.'), form.querySelector<HTMLInputElement>('#gb-name')!.focus());
      if (body.message.trim().length < 2) return void ((status.textContent = '메시지를 적어 주세요.'), msg.focus());

      const btn = form.querySelector<HTMLButtonElement>('.submit')!;
      btn.disabled = true;
      status.textContent = '보내는 중…';
      try {
        const res = await fetch('/api/guestbook', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '보내지 못했어요. 잠시 뒤에 다시 해 주세요.');
        form.reset();
        count.textContent = '0 / 1000';
        status.textContent = body.isPublic ? '남겼어요. 고마워요!' : '남겼어요. 저만 볼 수 있게 전달됐어요. 고마워요!';
        if (data.entry) {
          entries = [data.entry, ...entries];
          render(list, entries);
          empty.hidden = true;
        }
      } catch (e) {
        status.textContent = (e as Error).message;
      } finally {
        btn.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .form {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  label {
    font-size: var(--text-menu);
    color: var(--color-text);
  }
  .req {
    color: var(--color-accent-light);
  }
  input[type='text'],
  textarea {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    font-size: var(--text-body);
    line-height: 1.5;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input::placeholder {
    color: var(--color-text-muted);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
  }
  .hint {
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .count {
    justify-self: end;
    font-variant-numeric: tabular-nums;
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* 픽셀 체크박스 */
  .check {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    cursor: pointer;
  }
  .check input {
    position: absolute;
    opacity: 0;
    width: 20px;
    height: 20px;
    margin: 0;
  }
  .check .box {
    flex: none;
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-node);
    display: grid;
    place-items: center;
  }
  .check input:checked + .box::after {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--color-accent);
  }
  .check input:focus-visible + .box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  /* 흰 글씨 대비 4.5:1 이상을 위해 딥 와인 배경 + 자홍 테두리 */
  .submit {
    min-height: var(--tap-min);
    padding: 0 var(--space-6);
    background: var(--color-accent-deep);
    border: 2px solid var(--color-accent);
    color: var(--color-text);
    font-size: var(--text-menu);
    transition: border-color var(--dur-fast) var(--step-fast);
  }
  .submit:hover {
    border-color: var(--color-accent-light);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .status {
    font-size: var(--text-caption);
    color: var(--color-accent-light);
  }

  .board {
    display: grid;
    gap: var(--space-4);
  }
  .board a {
    color: var(--color-accent-light);
    text-decoration: underline;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .entry {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px dashed var(--color-border);
  }
  .entry:first-child {
    padding-top: 0;
  }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
  }
  .who::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-accent);
  }
  .msg {
    white-space: pre-wrap;
    color: var(--color-text-muted);
  }
  .reply {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
  }
  .reply .pixel-label {
    color: var(--color-accent-light);
  }
  .reply-msg {
    white-space: pre-wrap;
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>
