  function setupGuestbook() {
    const list = $('[data-gb-admin]');
    if (!list) return;
    const info = $('[data-gb-info]')!;
    type Entry = { id: string; name: string; contact: string; message: string; isPublic: boolean; createdAt: number; reply?: string };
    const fmt = (t: number) => new Date(t).toLocaleString('ko-KR', { dateStyle: 'medium', timeStyle: 'short' });

    const row = (e: Entry) => {
      const li = document.createElement('li');
      li.className = 'gb-item';
      const head = document.createElement('p');
      head.className = 'gb-head';
      const who = document.createElement('span');
      who.className = 'gb-who';
      who.textContent = e.name;
      const badge = document.createElement('span');
      badge.className = `badge ${e.isPublic ? 'pub' : ''}`;
      badge.textContent = e.isPublic ? '공개' : '비공개';
      const time = document.createElement('span');
      time.className = 'caption';
      time.textContent = fmt(e.createdAt);
      head.append(who, badge, time);
      const contact = document.createElement('p');
      contact.className = 'caption';
      contact.textContent = e.contact ? `연락처: ${e.contact}` : '연락처 없음';
      const msg = document.createElement('p');
      msg.className = 'gb-msg';
      msg.textContent = e.message;

      const replyId = `r-${e.id}`;
      const label = Object.assign(document.createElement('label'), { htmlFor: replyId, textContent: '답장 (공개 글이면 방문자에게도 보여요)' });
      const ta = Object.assign(document.createElement('textarea'), { id: replyId, rows: 2, maxLength: 1000, value: e.reply ?? '' });
      const acts = document.createElement('div');
      acts.className = 'actions';
      const mk = (text: string, cls: string, fn: () => Promise<void>) => {
        const b = Object.assign(document.createElement('button'), { type: 'button', textContent: text, className: `btn ${cls}` });
        b.addEventListener('click', async () => {
          b.disabled = true;
          try {
            await fn();
          } catch (err) {
            info.textContent = (err as Error).message;
          } finally {
            b.disabled = false;
          }
        });
        return b;
      };
      acts.append(
        mk('답장 저장', 'ghost', async () => {
          await api('/api/guestbook', { method: 'PATCH', body: JSON.stringify({ id: e.id, reply: ta.value }) });
          info.textContent = '답장을 저장했어요.';
        }),
        mk(e.isPublic ? '비공개로' : '공개로', 'ghost', async () => {
          await api('/api/guestbook', { method: 'PATCH', body: JSON.stringify({ id: e.id, isPublic: !e.isPublic }) });
          await load();
        }),
        mk('지우기', 'ghost danger', async () => {
          if (!confirm(`${e.name} 님의 글을 지울까요? 되돌릴 수 없어요.`)) return;
          await api(`/api/guestbook?id=${encodeURIComponent(e.id)}`, { method: 'DELETE' });
          await load();
        }),
      );
      li.append(head, contact, msg, label, ta, acts);
      return li;
    };

    const load = async () => {
      try {
        const data = await api('/api/guestbook', { method: 'GET' });
        const entries = data.entries as Entry[];
        info.textContent = `전체 ${entries.length}개 · 비공개 ${entries.filter((e) => !e.isPublic).length}개`;
        list.replaceChildren(...entries.map(row));
      } catch (err) {
        info.textContent = (err as Error).message;
      }
    };
    let loaded = false;
    const onTab = (id: string) => {
      if (id === 'guestbook' && !loaded) {
        loaded = true;
        load();
      }
    };
    document.addEventListener('admin:tab', (e) => onTab((e as CustomEvent).detail));
    if (location.hash === '#guestbook') onTab('guestbook');
  }

  function setupBeat() {
    const tapBtn = $<HTMLButtonElement>('[data-tap]');
    if (!tapBtn) return;
    const bpmIn = $<HTMLInputElement>('#b-bpm')!;
    const offIn = $<HTMLInputElement>('#b-offset')!;
    const barIn = $<HTMLSelectElement>('#b-bar')!;
    const info = $('[data-tap-info]')!;
    const status = $('[data-beat-status]')!;
    const metro = [...document.querySelectorAll<HTMLElement>('[data-metro]')];
    let taps: number[] = [];

    const apply = () => music.setBeat(Number(bpmIn.value), Number(offIn.value), Number(barIn.value));
    [bpmIn, offIn, barIn].forEach((el) => el.addEventListener('input', apply));
    apply();

    // 탭한 곡 시각들로 BPM(간격의 중앙값 → 직선 맞추기)과 첫 박 위치를 계산한다
    const compute = () => {
      if (taps.length < 4) return;
      const gaps = taps.slice(1).map((t, i) => t - taps[i]).sort((a, b) => a - b);
      const rough = gaps[Math.floor(gaps.length / 2)];
      const idx = taps.map((t) => Math.round((t - taps[0]) / rough));
      const n = taps.length;
      const mx = idx.reduce((a, b) => a + b, 0) / n;
      const my = taps.reduce((a, b) => a + b, 0) / n;
      let sxy = 0;
      let sxx = 0;
      idx.forEach((x, i) => ((sxy += (x - mx) * (taps[i] - my)), (sxx += (x - mx) ** 2)));
      const period = sxx ? sxy / sxx : rough;
      const first = my - period * mx; // 첫 탭(= 마디 첫 박) 시각
      const bar = period * Number(barIn.value);
      bpmIn.value = (60 / period).toFixed(2);
      offIn.value = (((first % bar) + bar) % bar).toFixed(3);
      apply();
    };

    const tap = () => {
      if (music.state !== 'playing') {
        info.textContent = '먼저 오른쪽 위 SOUND 를 눌러 음악을 켜 주세요.';
        return;
      }
      taps.push(music.time());
      if (taps.length > 1 && taps[taps.length - 1] < taps[taps.length - 2]) taps = [taps[taps.length - 1]]; // 곡이 처음으로 돌아가면 다시
      info.textContent = `탭 ${taps.length}번${taps.length < 8 ? ' — 8번 이상 눌러 주세요' : ''}`;
      compute();
      tapBtn.classList.add('hit');
      setTimeout(() => tapBtn.classList.remove('hit'), 90);
    };
    tapBtn.addEventListener('click', tap);
    document.addEventListener('keydown', (e) => {
      const panel = $('[data-panel="beat"]');
      if (e.code !== 'Space' || !panel || panel.hidden) return;
      if ((e.target as HTMLElement).closest('input, textarea, select, button')) return;
      e.preventDefault();
      tap();
    });
    $('[data-tap-reset]')!.addEventListener('click', () => {
      taps = [];
      info.textContent = '탭 0번';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-nudge]').forEach((b) =>
      b.addEventListener('click', () => {
        offIn.value = Math.max(0, Number(offIn.value) + Number(b.dataset.nudge)).toFixed(3);
        apply();
      }),
    );

    // 박자 미리보기: 박마다 네모가 켜진다 (강박은 자홍)
    const loop = () => {
      if (!document.contains(tapBtn)) return;
      const b = music.beat();
      const bar = Number(barIn.value);
      metro.forEach((m, i) => {
        m.hidden = i >= bar;
        const cur = b ? ((b.index % bar) + bar) % bar : -1;
        m.className = i === cur && b && b.phase < 0.35 ? (i === 0 ? 'on strong' : 'on') : '';
      });
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    $('[data-beat-save]')!.addEventListener('click', async () => {
      status.textContent = '저장하는 중…';
      try {
        await api('/api/admin/music', {
          method: 'POST',
          body: JSON.stringify({ bpm: Number(bpmIn.value), offset: Number(offIn.value), beatsPerBar: Number(barIn.value) }),
        });
        status.textContent = '저장했어요. 1–2분 뒤 사이트에 반영돼요.';
      } catch (err) {
        status.textContent = (err as Error).message;
      }
    });
  }

  /** 소개 수정: 프로필 · 이력(학력/연구 과제/수상/역량) · 논문 */
  type AbField = { key: string; label: string; type?: 'text' | 'textarea' | 'select' | 'number'; options?: [string, string][]; wide?: boolean; placeholder?: string; hint?: string };
  let abUid = 0;
  function rowList(box: HTMLElement, fields: AbField[], blank: () => Record<string, string>, unit: string) {
    let rows: Record<string, string>[] = [];
    const ol = $('[data-rows]', box)!;
    const render = () => {
      ol.replaceChildren(
        ...rows.map((r, i) => {
          const li = document.createElement('li');
          li.className = 'ab-row';
          const grid = document.createElement('div');
          grid.className = 'ab-grid';
          for (const f of fields) {
            const id = `ab-${f.key}-${++abUid}`;
            const wrap = document.createElement('div');
            wrap.className = `field${f.wide ? ' span2' : ''}`;
            const label = Object.assign(document.createElement('label'), { htmlFor: id, textContent: f.label });
            let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
            if (f.type === 'textarea') input = Object.assign(document.createElement('textarea'), { rows: 3 });
            else if (f.type === 'select') {
              input = document.createElement('select');
              f.options!.forEach(([v, t]) => (input as HTMLSelectElement).append(new Option(t, v)));
            } else input = Object.assign(document.createElement('input'), { type: f.type === 'number' ? 'number' : 'text' });
            input.id = id;
            if (f.placeholder && 'placeholder' in input) input.placeholder = f.placeholder;
            input.value = r[f.key] ?? '';
            input.addEventListener('input', () => (r[f.key] = input.value));
            wrap.append(label, input);
            if (f.hint) wrap.append(Object.assign(document.createElement('p'), { className: 'hint', textContent: f.hint }));
            grid.append(wrap);
          }
          const tools = document.createElement('div');
          tools.className = 'ab-tools';
          const mk = (text: string, aria: string, fn: () => void, disabled = false) => {
            const b = Object.assign(document.createElement('button'), { type: 'button', className: 'btn ghost', textContent: text, disabled });
            b.setAttribute('aria-label', `${unit} ${i + 1}번째 ${aria}`);
            b.addEventListener('click', () => {
              fn();
              render();
            });
            return b;
          };
          const swap = (j: number) => ([rows[i], rows[j]] = [rows[j], rows[i]]);
          tools.append(
            Object.assign(document.createElement('span'), { className: 'pixel-label', textContent: String(i + 1).padStart(2, '0') }),
            mk('↑', '위로', () => swap(i - 1), i === 0),
            mk('↓', '아래로', () => swap(i + 1), i === rows.length - 1),
            mk('삭제', '삭제', () => rows.splice(i, 1)),
          );
          li.append(tools, grid);
          return li;
        }),
      );
    };
    $('[data-add]', box)!.addEventListener('click', () => {
      rows.push(blank());
      render();
      (ol.lastElementChild?.querySelector('input, textarea, select') as HTMLElement | null)?.focus();
    });
    return {
      set(next: Record<string, string>[]) {
        rows = next;
        render();
      },
      get: () => rows,
    };
  }

  function setupAbout() {
    const form = $<HTMLFormElement>('[data-about]');
    if (!form) return;
    const info = $('[data-about-info]', form)!;
    const status = $('[data-about-status]', form)!;
    const photoImg = $<HTMLImageElement>('[data-ab-photo]', form)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const box = (k: string) => $(`[data-ab-list="${k}"]`, form)!;
    const cvFields: AbField[] = [
      { key: 'period', label: '기간', placeholder: '예: 2024 – 2026' },
      { key: 'title', label: '내용 *', wide: true },
      { key: 'note', label: '설명 (선택)', type: 'textarea', wide: true },
    ];
    const blankCv = () => ({ period: '', title: '', note: '' });
    const lists = {
      education: rowList(box('education'), cvFields, blankCv, '학력'),
      projects: rowList(box('projects'), cvFields, blankCv, '연구 과제'),
      awards: rowList(box('awards'), cvFields, blankCv, '수상'),
      skills: rowList(
        box('skills'),
        [
          { key: 'title', label: '역량 *', wide: true },
          { key: 'note', label: '설명', type: 'textarea', wide: true },
        ],
        () => ({ title: '', note: '' }),
        '역량',
      ),
      papers: rowList(
        box('papers'),
        [
          { key: 'type', label: '종류', type: 'select', options: [['thesis', '학위논문'], ['journal', '학술지'], ['conference', '학술대회']] },
          { key: 'year', label: '연도 *', type: 'number', placeholder: '2026' },
          { key: 'month', label: '월 (선택)', type: 'number', placeholder: '1–12' },
          { key: 'volume', label: '권·호 (선택)', placeholder: '예: 제26권 제5호' },
          { key: 'title', label: '제목 *', wide: true },
          { key: 'subtitle', label: '부제 (선택)', wide: true },
          { key: 'titleEn', label: '영문 제목 (선택)', wide: true },
          { key: 'authors', label: '저자 *', placeholder: '쉼표로 구분: 조연재, 홍길동', wide: true },
          { key: 'venue', label: '학회지·학교 *', wide: true },
          { key: 'summary', label: '요약', type: 'textarea', wide: true },
          { key: 'keywords', label: '키워드', placeholder: '쉼표로 구분', wide: true },
          { key: 'note', label: '수상 등 메모 (선택)', wide: true },
          { key: 'links', label: '원문 링크', type: 'textarea', wide: true, hint: '한 줄에 하나씩 "이름 | https://주소" (예: DBpia | https://www.dbpia.co.kr/...)' },
        ],
        () => ({ id: '', type: 'journal', year: String(new Date().getFullYear()), month: '', volume: '', title: '', subtitle: '', titleEn: '', authors: '', venue: '', summary: '', keywords: '', note: '', links: '' }),
        '논문',
      ),
    };

    type Paper = Record<string, any>;
    const load = async () => {
      info.textContent = '불러오는 중…';
      try {
        const d = await api('/api/admin/about', { method: 'GET' });
        const p = d.profile;
        el('name').value = p.name;
        el('nameEn').value = p.nameEn;
        el('headline').value = p.headline;
        el('body').value = p.body === '[여기에 소개글]' ? '' : p.body;
        el('interests').value = p.interests.join(', ');
        el('email').value = p.email;
        el('photoAlt').value = p.photoAlt;
        el('photo').value = '';
        photoImg.hidden = !p.photoUrl;
        if (p.photoUrl) photoImg.src = p.photoUrl;
        const rowsOf = (v: unknown) => (Array.isArray(v) ? v : []).map((r: Record<string, unknown>) => Object.fromEntries(Object.entries(r).map(([k, x]) => [k, String(x ?? '')])));
        lists.education.set(rowsOf(d.cv.education));
        lists.projects.set(rowsOf(d.cv.projects));
        lists.awards.set(rowsOf(d.cv.awards));
        lists.skills.set(rowsOf(d.cv.skills));
        lists.papers.set(
          (d.papers as Paper[]).map((x) => ({
            id: x.id ?? '',
            type: x.type ?? 'journal',
            year: String(x.year ?? ''),
            month: x.month ? String(x.month) : '',
            volume: x.volume ?? '',
            title: x.title ?? '',
            subtitle: x.subtitle ?? '',
            titleEn: x.titleEn ?? '',
            authors: (x.authors ?? []).join(', '),
            venue: x.venue ?? '',
            summary: x.summary ?? '',
            keywords: (x.keywords ?? []).join(', '),
            note: x.note ?? '',
            links: (x.links ?? []).map((l: { label: string; href: string }) => `${l.label} | ${l.href}`).join('\n'),
          })),
        );
        info.textContent = '고친 뒤 맨 아래 「소개 저장」을 누르면 1–2분 뒤 소개 페이지에 반영돼요.';
      } catch (err) {
        info.textContent = (err as Error).message;
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      try {
        let photo: { sha: string; ext: string } | undefined;
        const file = el('photo').files?.[0];
        if (file) {
          status.textContent = '사진 올리는 중…';
          photo = (await api('/api/admin/blob', { method: 'POST', body: JSON.stringify({ data: await shrink(file, 1600) }) })) as { sha: string; ext: string };
        }
        status.textContent = '저장하는 중…';
        const papers = lists.papers.get().map((x) => ({
          ...x,
          links: String(x.links ?? '')
            .split('\n')
            .map((line) => line.trim())
            .filter(Boolean)
            .map((line) => {
              const [label, ...rest] = line.split('|');
              return { label: label.trim(), href: rest.join('|').trim() };
            }),
        }));
        await api('/api/admin/about', {
          method: 'PUT',
          body: JSON.stringify({
            profile: {
              name: el('name').value,
              nameEn: el('nameEn').value,
              headline: el('headline').value,
              body: el('body').value,
              interests: el('interests').value,
              email: el('email').value,
              photoAlt: el('photoAlt').value,
              photo,
            },
            cv: { education: lists.education.get(), projects: lists.projects.get(), awards: lists.awards.get(), skills: lists.skills.get() },
            papers,
          }),
        });
        status.replaceChildren('저장했어요! 1–2분 뒤 반영돼요 → ', Object.assign(document.createElement('a'), { href: '/about', textContent: '/about' }));
        await load();
      } catch (err) {
        status.textContent = (err as Error).message;
      } finally {
        btn.disabled = false;
      }
    });

    let loaded = false;
    const onTab = (id: string) => {
      if (id === 'about' && !loaded) {
        loaded = true;
        void load();
      }
    };
    document.addEventListener('admin:tab', (e) => onTab((e as CustomEvent).detail));
    if (location.hash === '#about') onTab('about');
  }

  function setupPosts() {
    const status = $('[data-posts-status]');
    if (!status) return;
    document.querySelectorAll<HTMLButtonElement>('[data-del-slug]').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm(`「${b.dataset.delTitle}」을(를) 지울까요? 이미지도 함께 지워져요.`)) return;
        b.disabled = true;
        status.textContent = '지우는 중…';
        try {
          await api('/api/admin/posts', { method: 'DELETE', body: JSON.stringify({ kind: b.dataset.delKind, slug: b.dataset.delSlug }) });
          b.closest('li')?.remove();
          status.textContent = '지웠어요. 1–2분 뒤 사이트에서 사라져요.';
        } catch (err) {
          status.textContent = (err as Error).message;
          b.disabled = false;
        }
      }),
    );
  }

  document.addEventListener('astro:page-load', () => {
    setupLogin();
    setupTabs();
    setupDialogs();
    setupUpload();
    setupGuestbook();
    setupBeat();
    setupPosts();
    setupAbout();
  });
</script>

