---
/*
 * 관리자 페이지 (주인 전용). 서버에서 실행되고 검색엔진에 올리지 않는다.
 * - 올리기: 포트폴리오(연구·디자인) / 그 외 작업물(글·그림) 을 GitHub 에 커밋 → 자동 재배포
 * - 방명록: 비공개 글·연락처 보기, 답장, 공개 전환, 삭제
 * - 박자 맞추기: 음악을 들으며 탭해서 BPM·첫 박 위치를 정해 저장
 * - 올린 글: 수정 · 지우기 (/admin?edit=<kind>/<slug> 로 열면 그 글을 고치는 화면)
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { adminConfigured, isAdmin } from '../lib/server/session';
import { githubConfigured } from '../lib/server/github';
import { getStore } from '../lib/server/store';
import { KINDS } from '../lib/server/content';
import { MUSIC } from '../data/site';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');

const configured = adminConfigured();
const loggedIn = configured && isAdmin(Astro.cookies);
const hasGithub = githubConfigured();
const hasStore = Boolean(getStore());
const kindParam = Astro.url.searchParams.get('kind');
// 수정: ?edit=<kind>/<slug>
const [editKind, editSlug] = (Astro.url.searchParams.get('edit') ?? '').split('/');
const editing = editKind in KINDS && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(editSlug ?? '');
const initialKind = editing ? editKind : kindParam && kindParam in KINDS ? kindParam : 'design';
const today = new Date().toISOString().slice(0, 10);

const posts = loggedIn
  ? [
      ...(await getCollection('portfolio')).map((e) => ({ kind: e.data.category, slug: e.id, title: e.data.title, date: e.data.date, base: '/portfolio' })),
      ...(await getCollection('works')).map((e) => ({ kind: e.data.category, slug: e.id, title: e.data.title, date: e.data.date, base: '/works' })),
    ].sort((a, b) => b.date.getTime() - a.date.getTime())
  : [];
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title="관리자" noindex>
  <div class="admin-root">
  <div class="head">
    <p class="pixel-label">Admin</p>
    <h1 class="page-title">관리자</h1>
  </div>

  {!configured && (
    <section class="panel-box">
      <h2 class="h">아직 관리자 설정이 안 됐어요</h2>
      <p class="caption">
        Vercel 프로젝트 → Settings → Environment Variables 에 <code>ADMIN_PASSWORD</code>(로그인 비밀번호)와
        <code>SESSION_SECRET</code>(16자 이상 아무 문자열)을 넣고 다시 배포해 주세요.
      </p>
    </section>
  )}

  {configured && !loggedIn && (
    <form class="panel-box login" data-login method="post" action="/api/admin/login">
      <input type="hidden" name="next" value={Astro.url.searchParams.get('next') ?? ''} />
      <label for="admin-pw">비밀번호</label>
      <input id="admin-pw" name="password" type="password" autocomplete="current-password" required />
      <button type="submit" class="btn primary">로그인</button>
      <p class="hint">로그인하면 이 브라우저에서 글 올리기·수정, 포스트잇 쓰기, 소개 수정 버튼이 보여요.</p>
      <p class="status" role="status" aria-live="polite" data-login-status>{Astro.url.searchParams.get('error') ? '비밀번호가 맞지 않아요.' : ''}</p>
    </form>
  )}

  {loggedIn && (
    <>
      <div class="bar">
        <div class="tabs" role="tablist" aria-label="관리 메뉴" data-admin-tabs>
          <button type="button" role="tab" id="t-upload" aria-controls="p-upload" aria-selected="true" data-tab="upload">{editing ? '글 수정' : '올리기'}</button>
          <button type="button" role="tab" id="t-guestbook" aria-controls="p-guestbook" aria-selected="false" tabindex="-1" data-tab="guestbook">방명록</button>
          <button type="button" role="tab" id="t-beat" aria-controls="p-beat" aria-selected="false" tabindex="-1" data-tab="beat">박자 맞추기</button>
          <button type="button" role="tab" id="t-posts" aria-controls="p-posts" aria-selected="false" tabindex="-1" data-tab="posts">올린 글</button>
          <button type="button" role="tab" id="t-about" aria-controls="p-about" aria-selected="false" tabindex="-1" data-tab="about">소개 수정</button>
        </div>
        <button type="button" class="btn ghost" data-logout>로그아웃</button>
      </div>

      {(!hasGithub || !hasStore) && (
        <p class="warn">
          {!hasGithub && <span>올리기·박자 저장에는 <code>GITHUB_TOKEN</code> 이 필요해요. </span>}
          {!hasStore && <span>방명록에는 Upstash Redis 연결이 필요해요.</span>}
        </p>
      )}

      <!-- 올리기 -->
      <section role="tabpanel" id="p-upload" aria-labelledby="t-upload" data-panel="upload">
        {editing && (
          <div class="edit-bar">
            <p><span class="pixel-label">Edit</span> 올린 글을 고치는 중이에요. 주소 이름과 종류는 바꿀 수 없어요.</p>
            <a class="btn ghost" href="/admin">새 글 쓰기로</a>
          </div>
        )}
        <form class="upload" data-upload novalidate data-edit-kind={editing ? editKind : undefined} data-edit-slug={editing ? editSlug : undefined}>
          <fieldset class="kinds" disabled={editing}>
            <legend class="pixel-label">Type</legend>
            {Object.entries(KINDS).map(([k, v]) => (
              <label class="kind">
                <input type="radio" name="kind" value={k} checked={k === initialKind} />
                <span>{v.label}</span>
              </label>
            ))}
          </fieldset>

          <div class="grid2">
            <div class="field span2">
              <label for="u-title">제목 *</label>
              <input id="u-title" name="title" type="text" maxlength="120" required />
            </div>
            <div class="field span2" data-for="portfolio">
              <label for="u-subtitle">부제</label>
              <input id="u-subtitle" name="subtitle" type="text" maxlength="120" />
            </div>
            <div class="field">
              <label for="u-date">날짜 *</label>
              <input id="u-date" name="date" type="date" value={today} required />
              <p class="hint">목록 정렬 기준 (최신이 앞)</p>
            </div>
            <div class="field" data-for="portfolio">
              <label for="u-period">기간 표시</label>
              <input id="u-period" name="period" type="text" maxlength="40" placeholder="예: 2025.03 – 2025.06" />
              <p class="hint">비우면 날짜의 연.월</p>
            </div>
            <div class="field span2">
              <label for="u-summary">한 줄 설명</label>
              <input id="u-summary" name="summary" type="text" maxlength="200" placeholder="카드에 보이는 문장" />
            </div>
            <div class="field">
              <label for="u-tags">태그</label>
              <input id="u-tags" name="tags" type="text" placeholder="쉼표로 구분: 포스터, 타이포" />
            </div>
            <div class="field">
              <label for="u-slug">주소 이름 (영문)</label>
              <input id="u-slug" name="slug" type="text" maxlength="60" pattern="[a-z0-9-]*" placeholder="예: poster-series" readonly={editing} value={editing ? editSlug : undefined} />
              <p class="hint">{editing ? '이미 올린 글의 주소는 그대로 둬요' : '비우면 날짜로 자동: 주소가 /…/이름 이 돼요'}</p>
            </div>
            <div class="field" data-for="portfolio">
              <label for="u-role">역할</label>
              <input id="u-role" name="role" type="text" maxlength="80" placeholder="예: 기획·디자인" />
            </div>
            <div class="field" data-for="portfolio">
              <label for="u-tools">도구</label>
              <input id="u-tools" name="tools" type="text" placeholder="쉼표로 구분: Figma, Illustrator" />
            </div>
          </div>

          <div class="grid2">
            <div class="field">
              <label for="u-thumb">썸네일 이미지</label>
              <div class="thumb-now" data-thumb-now hidden>
                <img alt="지금 썸네일" data-thumb-img />
                <label class="check"><input type="checkbox" data-thumb-remove /> 썸네일 빼기</label>
              </div>
              <input id="u-thumb" name="thumb" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
              <div class="thumb-now" data-thumb-picked hidden>
                <img alt="고른 썸네일" data-picked-img />
                <div class="picked-info">
                  <p class="caption" data-picked-credit></p>
                  <button type="button" class="btn ghost" data-picked-clear>고른 그림 빼기</button>
                </div>
              </div>
              <button type="button" class="btn ghost art-open" data-art-open>명화에서 고르기</button>
              <p class="hint">3:2 비율 권장. 2000px·3MB 이하는 원본 그대로 올려요{editing && ' · 새 파일을 고르면 바뀌어요'}</p>
            </div>
            <div class="field">
              <label for="u-alt">썸네일 설명</label>
              <input id="u-alt" name="thumbnailAlt" type="text" maxlength="200" placeholder="화면 낭독기용 한 문장" />
            </div>
            <div class="field span2">
              <label for="u-images">글 아래 그림 모음 (선택)</label>
              <input id="u-images" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
              <p class="hint">고를 때마다 뒤에 붙어요. ← → 로 순서를 바꾸고 ✕ 로 뺄 수 있어요. 그림마다 보이는 크기를 고를 수 있어요(원본보다 크게 늘어나지 않아요). 본문 중간에 넣으려면 편집기의 그림 버튼을 쓰세요</p>
              <div class="gallery-all" data-gallery-all hidden>
                <label for="u-size-all">전체 크기</label>
                <select id="u-size-all">
                  <option value="">한꺼번에 바꾸기…</option>
                  <option value="original">원본</option>
                  <option value="small">작게 (40%)</option>
                  <option value="medium">중간 (70%)</option>
                  <option value="full">꽉 차게</option>
                </select>
              </div>
              <ol class="previews" data-previews></ol>
            </div>
          </div>

          <div class="field">
            <span class="label" id="u-body-label">본문</span>
            <div class="md-box" data-md-box hidden>
              <p class="hint">이 글은 마크다운(표·목록 기호)으로 쓰여 있어서 글자 그대로 고쳐요. <code>##</code> 소제목, <code>**굵게**</code>, <code>| 표 |</code></p>
              <textarea data-markdown rows="24" aria-labelledby="u-body-label" spellcheck="false"></textarea>
            </div>
            <div class="editor" aria-labelledby="u-body-label" data-editor-box>
              <div class="toolbar" role="toolbar" aria-label="본문 서식" data-toolbar>
                <div class="group">
                  <select data-block aria-label="문단 형식">
                    <option value="p">본문</option>
                    <option value="2">소제목</option>
                    <option value="3">작은 제목</option>
                  </select>
                  <select data-size aria-label="글자 크기">
                    <option value="">크기</option>
                    {['12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '40px'].map((v) => <option value={v}>{v.replace('px', '')}</option>)}
                  </select>
                </div>
                <div class="group">
                  <button type="button" data-cmd="bold" aria-pressed="false" title="굵게 (⌘B)"><b>B</b></button>
                  <button type="button" data-cmd="italic" aria-pressed="false" title="기울임 (⌘I)"><i>I</i></button>
                  <button type="button" data-cmd="underline" aria-pressed="false" title="밑줄 (⌘U)"><u>U</u></button>
                  <button type="button" data-cmd="strike" aria-pressed="false" title="취소선"><s>S</s></button>
                </div>
                <div class="group">
                  <label class="swatch" title="글자 색">
                    <span aria-hidden="true">가</span>
                    <input type="color" data-color value="#f26d9a" aria-label="글자 색" />
                  </label>
                  <button type="button" data-cmd="color-clear" title="글자 색 지우기" aria-label="글자 색 지우기">색 ✕</button>
                  <label class="swatch bg" title="글자 배경색">
                    <span aria-hidden="true">배경</span>
                    <input type="color" data-bg value="#9e1f4a" aria-label="글자 배경색" />
                  </label>
                  <button type="button" data-cmd="bg-clear" title="배경색 지우기" aria-label="배경색 지우기">배경 ✕</button>
                </div>
                <div class="group">
                  <button type="button" data-cmd="align-left" aria-pressed="false" title="왼쪽 정렬" aria-label="왼쪽 정렬">⇤</button>
                  <button type="button" data-cmd="align-center" aria-pressed="false" title="가운데 정렬" aria-label="가운데 정렬">↔</button>
                  <button type="button" data-cmd="align-right" aria-pressed="false" title="오른쪽 정렬" aria-label="오른쪽 정렬">⇥</button>
                  <button type="button" data-cmd="align-justify" aria-pressed="false" title="양쪽 정렬" aria-label="양쪽 정렬">☰</button>
                </div>
                <div class="group">
                  <button type="button" data-cmd="bullet" aria-pressed="false" title="글머리 목록" aria-label="글머리 목록">•</button>
                  <button type="button" data-cmd="ordered" aria-pressed="false" title="번호 목록" aria-label="번호 목록">1.</button>
                  <button type="button" data-cmd="quote" aria-pressed="false" title="인용" aria-label="인용">❝</button>
                  <button type="button" data-cmd="hr" title="문단 나누는 줄" aria-label="문단 나누는 줄">―</button>
                  <button type="button" data-cmd="link" aria-pressed="false" title="링크" aria-label="링크">링크</button>
                </div>
                <div class="group">
                  <button type="button" data-cmd="image" title="그림 넣기">그림 +</button>
                  <input type="file" data-image-input accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden />
                  <span class="group img-tools" data-image-tools hidden>
                    <span class="hint">그림 크기</span>
                    <button type="button" data-cmd="img-original" aria-pressed="false">원본</button>
                    <button type="button" data-cmd="img-small" aria-pressed="false">작게</button>
                    <button type="button" data-cmd="img-medium" aria-pressed="false">중간</button>
                    <button type="button" data-cmd="img-full" aria-pressed="false">꽉 차게</button>
                  </span>
                </div>
                <div class="group">
                  <button type="button" data-cmd="undo" title="실행 취소 (⌘Z)" aria-label="실행 취소">↶</button>
                  <button type="button" data-cmd="redo" title="다시 실행 (⇧⌘Z)" aria-label="다시 실행">↷</button>
                </div>
              </div>
              <div data-editor></div>
            </div>
            <p class="status" role="status" aria-live="polite" data-editor-notice></p>
            <p class="hint" data-editor-hint>그림은 끌어다 놓거나 붙여 넣어도 들어가요. 그림을 누르면 크기를 고를 수 있고, 끌어서 위치를 옮길 수 있어요. 원본 크기보다 크게 늘어나지 않아요.</p>
          </div>

          <div class="actions">
            <button type="button" class="btn ghost" data-preview-open>미리보기</button>
            <button type="submit" class="btn primary" disabled={!hasGithub}>{editing ? '수정 저장' : '올리기'}</button>
            {editing && <button type="button" class="btn ghost danger" data-edit-delete disabled={!hasGithub}>이 글 지우기</button>}
            <p class="status" role="status" aria-live="polite" data-upload-status>{editing ? '불러오는 중…' : ''}</p>
          </div>
        </form>

        <!-- 명화에서 썸네일 고르기 -->
        <dialog class="dlg art" data-art aria-labelledby="art-title">
          <div class="dlg-head">
            <h2 id="art-title" class="h">명화에서 썸네일 고르기</h2>
            <button type="button" class="btn ghost" data-dialog-close>닫기</button>
          </div>
          <form class="art-search" data-art-form>
            <label for="art-q" class="visually-hidden">검색어</label>
            <input id="art-q" type="text" maxlength="80" placeholder="영어로: rose, sea, night, cat, Monet…" autocomplete="off" />
            <button class="btn primary" type="submit">검색</button>
          </form>
          <p class="hint">시카고 미술관·클리블랜드 미술관의 저작권이 끝난 작품(퍼블릭 도메인·CC0)만 나와요. 고르면 가운데를 3:2 로 잘라 썸네일로 넣고, 작품 정보는 썸네일 설명에 적어 둬요.</p>
          <p class="status" role="status" aria-live="polite" data-art-status></p>
          <ul class="art-grid" data-art-results></ul>
        </dialog>

        <!-- 미리보기 -->
        <dialog class="dlg pv" data-preview aria-labelledby="pv-title">
          <div class="dlg-head">
            <h2 id="pv-title" class="pixel-label">Preview</h2>
            <span class="hint">아직 저장 전이에요. 실제 사이트와 같은 글꼴·색으로 보여요.</span>
            <button type="button" class="btn ghost" data-dialog-close>닫기</button>
          </div>
          <div class="pv-body" data-preview-body></div>
        </dialog>
      </section>

      <!-- 방명록 -->
      <section role="tabpanel" id="p-guestbook" aria-labelledby="t-guestbook" data-panel="guestbook" hidden>
        <p class="caption" data-gb-info>불러오는 중…</p>
        <ol class="gb" data-gb-admin></ol>
      </section>

      <!-- 박자 맞추기 -->
      <section role="tabpanel" id="p-beat" aria-labelledby="t-beat" data-panel="beat" hidden>
        <div class="beat">
          <ol class="steps caption">
            <li>오른쪽 위 <strong>SOUND</strong> 를 눌러 음악을 켜요.</li>
            <li>마디의 첫 박(가장 센 박)부터 박자에 맞춰 <strong>탭</strong> 버튼을 누르거나 <kbd>Space</kbd> 를 8번 이상 눌러요.</li>
            <li>아래 네모가 음악과 같이 깜빡이면 <strong>저장</strong>. 어긋나면 −/+ 로 조금씩 옮겨요.</li>
          </ol>

          <div class="tap-row">
            <button type="button" class="tap" data-tap>탭</button>
            <div class="metro" aria-hidden="true">
              <span data-metro></span><span data-metro></span><span data-metro></span><span data-metro></span>
            </div>
          </div>
          <p class="caption" data-tap-info>탭 0번</p>

          <div class="grid3">
            <div class="field">
              <label for="b-bpm">BPM</label>
              <input id="b-bpm" type="number" min="40" max="240" step="0.01" value={MUSIC.bpm} />
            </div>
            <div class="field">
              <label for="b-offset">첫 박 위치 (초)</label>
              <div class="nudge">
                <button type="button" class="btn ghost" data-nudge="-0.02" aria-label="첫 박 0.02초 앞으로">−</button>
                <input id="b-offset" type="number" min="0" max="59" step="0.001" value={MUSIC.offset} />
                <button type="button" class="btn ghost" data-nudge="0.02" aria-label="첫 박 0.02초 뒤로">+</button>
              </div>
            </div>
            <div class="field">
              <label for="b-bar">한 마디 박 수</label>
              <select id="b-bar">
                {[2, 3, 4, 6].map((n) => <option value={n} selected={n === MUSIC.beatsPerBar}>{n}</option>)}
              </select>
            </div>
          </div>
          <div class="actions">
            <button type="button" class="btn ghost" data-tap-reset>탭 다시 하기</button>
            <button type="button" class="btn primary" data-beat-save disabled={!hasGithub}>저장</button>
            <p class="status" role="status" aria-live="polite" data-beat-status></p>
          </div>
          <p class="hint">지금 저장된 값: {MUSIC.bpm} BPM · 첫 박 {MUSIC.offset}초 · {MUSIC.beatsPerBar}박자</p>
        </div>
      </section>

      <!-- 소개 수정 -->
      <section role="tabpanel" id="p-about" aria-labelledby="t-about" data-panel="about" hidden>
        <form class="about-form" data-about novalidate>
          <p class="caption" data-about-info>불러오는 중…</p>

          <fieldset class="abox">
            <legend class="h">프로필</legend>
            <div class="grid2">
              <div class="field">
                <label for="ab-name">이름 *</label>
                <input id="ab-name" name="name" type="text" maxlength="40" />
              </div>
              <div class="field">
                <label for="ab-nameEn">영문 이름 *</label>
                <input id="ab-nameEn" name="nameEn" type="text" maxlength="60" />
              </div>
              <div class="field span2">
                <label for="ab-headline">한 줄 소개 *</label>
                <input id="ab-headline" name="headline" type="text" maxlength="160" />
              </div>
              <div class="field span2">
                <label for="ab-body">소개글</label>
                <textarea id="ab-body" name="body" rows="7" maxlength="6000"></textarea>
                <p class="hint">빈 줄을 하나 넣으면 문단이 나뉘어요. <code>**굵게**</code> 처럼 쓰면 강조돼요.</p>
              </div>
              <div class="field">
                <label for="ab-interests">관심 분야</label>
                <input id="ab-interests" name="interests" type="text" placeholder="쉼표로 구분: 게임 연구, 사용자 연구" />
              </div>
              <div class="field">
                <label for="ab-email">이메일 *</label>
                <input id="ab-email" name="email" type="text" maxlength="120" autocomplete="off" />
              </div>
              <div class="field">
                <label for="ab-photo">프로필 사진</label>
                <img class="ab-photo" alt="지금 프로필 사진" data-ab-photo hidden />
                <input id="ab-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" />
                <p class="hint">새 파일을 고르면 바뀌어요. 정사각형 800px 이상 권장</p>
              </div>
              <div class="field">
                <label for="ab-photoAlt">사진 설명</label>
                <input id="ab-photoAlt" name="photoAlt" type="text" maxlength="200" placeholder="화면 낭독기용 한 문장" />
              </div>
            </div>
          </fieldset>

          {[
            ['education', '학력', '+ 학력 추가'],
            ['projects', '참여 연구 과제', '+ 연구 과제 추가'],
            ['awards', '수상', '+ 수상 추가'],
            ['skills', '역량', '+ 역량 추가'],
            ['papers', '논문', '+ 논문 추가'],
          ].map(([key, label, add]) => (
            <fieldset class="abox" data-ab-list={key}>
              <legend class="h">{label}</legend>
              <ol class="ab-rows" data-rows></ol>
              <button type="button" class="btn ghost" data-add>{add}</button>
            </fieldset>
          ))}

          <div class="actions sticky-save">
            <button type="submit" class="btn primary" disabled={!hasGithub}>소개 저장</button>
            <a class="btn ghost" href="/about" target="_blank" rel="noopener">소개 페이지 보기 ↗</a>
            <p class="status" role="status" aria-live="polite" data-about-status></p>
          </div>
        </form>
      </section>

      <!-- 올린 글 -->
      <section role="tabpanel" id="p-posts" aria-labelledby="t-posts" data-panel="posts" hidden>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <span class="pixel-label kind-l">{KINDS[p.kind as keyof typeof KINDS].label}</span>
              <a class="t" href={`${p.base}/${p.slug}`}>{p.title}</a>
              <span class="caption">{fmt(p.date)}</span>
              <a class="btn ghost" href={`/admin?edit=${p.kind}/${p.slug}`}>수정</a>
              <button type="button" class="btn ghost danger" data-del-kind={p.kind} data-del-slug={p.slug} data-del-title={p.title} disabled={!hasGithub}>지우기</button>
            </li>
          ))}
        </ul>
        <p class="status" role="status" aria-live="polite" data-posts-status></p>
      </section>
    </>
  )}
  </div>
</BaseLayout>

<script>
  import { music } from '../scripts/music';
  import { createEditor } from '../scripts/editor';
  import { markdownToHtml, renderPreview } from '../scripts/preview';

  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s);
  const api = async (url: string, init: RequestInit = {}) => {
    const res = await fetch(url, { ...init, headers: { 'content-type': 'application/json', ...init.headers } });
    const text = await res.text();
    let data: Record<string, any> = {};
    try {
      data = JSON.parse(text);
    } catch {}
    // 서버가 이유를 안 보내면 받은 내용 앞부분이라도 보여 준다
    if (!res.ok) throw new Error(data.error || `요청이 실패했어요 (${res.status}) ${text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160)}`);
    return data;
  };

  // ── 이미지: 작은 그림은 원본 그대로, 큰 그림만 줄여서(고화질) base64 로 ──
  const toBase64 = (blob: Blob) =>
    new Promise<string>((ok, no) => {
      const r = new FileReader();
      r.onload = () => ok(String(r.result).split(',')[1]);
      r.onerror = () => no(r.error);
      r.readAsDataURL(blob);
    });
  const MAX_BYTES = 3 * 1024 * 1024; // 서버가 받는 한 장 최대 크기
  const KEEP = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
  async function shrink(file: File, maxW: number): Promise<string> {
    // 다시 압축하면 선이 뭉개지므로: 가로 maxW 이하·3MB 이하면 원본 파일 그대로 올린다
    if (file.type === 'image/gif' && file.size <= MAX_BYTES) return toBase64(file); // 움직이는 GIF
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' } as ImageBitmapOptions);
    if (KEEP.includes(file.type) && bmp.width <= maxW && file.size <= MAX_BYTES) return toBase64(file);
    // 큰 그림만 줄인다. 원본이 PNG(선화·투명)면 PNG 를 먼저, 아니면 고화질 WebP
    const scale = Math.min(1, maxW / bmp.width);
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale);
    c.height = Math.round(bmp.height * scale);
    const ctx = c.getContext('2d')!;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(bmp, 0, 0, c.width, c.height);
    const enc = (type: string, q?: number) => new Promise<Blob | null>((ok) => c.toBlob(ok, type, q));
    let blob: Blob | null = null;
    if (file.type === 'image/png') {
      blob = await enc('image/png');
      if (blob && blob.size > MAX_BYTES) blob = null;
    }
    for (const q of [0.92, 0.85, 0.75]) {
      if (blob) break;
      const b = await enc('image/webp', q);
      const ok = b && b.type === 'image/webp' ? b : await enc('image/jpeg', q);
      if (ok && ok.size <= MAX_BYTES) blob = ok;
    }
    if (!blob) throw new Error(`「${file.name}」이 너무 커서 올릴 수 없어요.`);
    return toBase64(blob);
  }

  function setupLogin() {
    const form = $<HTMLFormElement>('[data-login]');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = $('[data-login-status]')!;
      status.textContent = '확인 중…';
      try {
        await api('/api/admin/login', { method: 'POST', body: JSON.stringify({ password: new FormData(form).get('password') }) });
        // 다른 페이지의 「로그인」으로 왔으면 그 페이지로 돌아간다 (이 사이트 안 주소만)
        const next = new URLSearchParams(location.search).get('next') ?? '';
        if (/^\/(?![/\\])/.test(next) && !next.includes('\\') && !next.startsWith('/admin')) location.href = next;
        else location.reload();
      } catch (err) {
        status.textContent = (err as Error).message;
      }
    });
  }

  function setupTabs() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-tabs] [role="tab"]')];
    if (!tabs.length) return;
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      document.dispatchEvent(new CustomEvent('admin:tab', { detail: id }));
      history.replaceState(history.state, '', `${location.pathname}${location.search}#${id}`);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(tabs[n].dataset.tab!, true);
      });
    });
    const hash = location.hash.slice(1);
    if (tabs.some((t) => t.dataset.tab === hash)) select(hash);
    $('[data-logout]')?.addEventListener('click', async () => {
      await api('/api/admin/login', { method: 'DELETE' }).catch(() => {});
      location.href = '/';
    });
  }

  function setupUpload() {
    const form = $<HTMLFormElement>('[data-upload]');
    if (!form) return;
    const status = $('[data-upload-status]')!;
    const editKind = form.dataset.editKind;
    const editSlug = form.dataset.editSlug;
    const editing = Boolean(editKind && editSlug);
    const kindOf = () => editKind ?? (form.elements.namedItem('kind') as RadioNodeList).value;
    const syncKind = () => {
      const kind = kindOf();
      const portfolio = kind === 'research' || kind === 'design';
      form.querySelectorAll<HTMLElement>('[data-for="portfolio"]').forEach((el) => (el.hidden = !portfolio));
    };
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'kind') syncKind();
    });
    syncKind();

    const notice = $('[data-editor-notice]', form)!;
    const rich = createEditor($('[data-editor]', form)!, $('[data-toolbar]', form)!, undefined, (msg) => (notice.textContent = msg));
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

    // ── 글 아래 그림 모음: 남길 그림(이미 올린 것) + 새 그림. 순서 바꾸기·빼기 ──
    type Size = 'original' | 'small' | 'medium' | 'full';
    const SIZE_LABEL: Record<Size, string> = { original: '원본', small: '작게', medium: '중간', full: '꽉 차게' };
    type GalleryItem = ({ keep: string } | { file: File }) & { url: string; size: Size };
    let gallery: GalleryItem[] = [];
    const galleryList = $('[data-previews]', form)!;
    const allBox = $('[data-gallery-all]', form)!;
    const allSel = $<HTMLSelectElement>('#u-size-all', form)!;
    allSel.addEventListener('change', () => {
      if (!allSel.value) return;
      gallery.forEach((g) => (g.size = allSel.value as Size));
      allSel.value = '';
      renderGallery();
    });
    const renderGallery = () => {
      allBox.hidden = gallery.length < 2;
      galleryList.replaceChildren(
        ...gallery.map((it, i) => {
          const li = document.createElement('li');
          const img = Object.assign(document.createElement('img'), { src: it.url, alt: `${i + 1}번째 그림` });
          const no = Object.assign(document.createElement('span'), { className: 'pixel-label no', textContent: String(i + 1).padStart(2, '0') });
          if ('file' in it) no.textContent += ' NEW';
          const tools = document.createElement('span');
          tools.className = 'tools';
          const mk = (text: string, label: string, fn: () => void, disabled = false) => {
            const b = Object.assign(document.createElement('button'), { type: 'button', textContent: text, disabled });
            b.setAttribute('aria-label', `${i + 1}번째 그림 ${label}`);
            b.addEventListener('click', () => {
              fn();
              renderGallery();
            });
            return b;
          };
          const swap = (j: number) => ([gallery[i], gallery[j]] = [gallery[j], gallery[i]]);
          tools.append(
            mk('←', '앞으로', () => swap(i - 1), i === 0),
            mk('→', '뒤로', () => swap(i + 1), i === gallery.length - 1),
            mk('✕', '빼기', () => gallery.splice(i, 1)),
          );
          const sel = document.createElement('select');
          sel.setAttribute('aria-label', `${i + 1}번째 그림 크기`);
          (Object.keys(SIZE_LABEL) as Size[]).forEach((k) => sel.append(new Option(`크기: ${SIZE_LABEL[k]}`, k, false, it.size === k)));
          sel.addEventListener('change', () => (it.size = sel.value as Size));
          li.append(img, no, tools, sel);
          return li;
        }),
      );
    };
    const imagesInput = $<HTMLInputElement>('#u-images', form)!;
    imagesInput.addEventListener('change', () => {
      gallery.push(...[...(imagesInput.files ?? [])].map((file) => ({ file, url: URL.createObjectURL(file), size: 'original' as Size })));
      imagesInput.value = '';
      renderGallery();
    });

    // ── 수정: 지금 저장된 내용 불러오기 ──
    type Loaded = {
      title: string; subtitle: string; date: string; period: string; summary: string; tags: string[]; role: string; tools: string[];
      thumbnailAlt: string; thumbnail: { path: string; url: string } | null; images: { path: string; url: string; size: Size }[];
      mode: 'rich' | 'markdown'; body: string; previewPrefix: string; uploadPrefix: string; assetPrefix: string; uploads: string[];
    };
    let loaded: Loaded | null = null;
    const thumbNow = $('[data-thumb-now]', form)!;
    const thumbRemove = $<HTMLInputElement>('[data-thumb-remove]', form)!;
    const mdBox = $('[data-md-box]', form)!;
    const mdArea = $<HTMLTextAreaElement>('[data-markdown]', form)!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // ── 명화에서 고른 썸네일 (파일을 직접 고르면 그쪽이 우선) ──
    let picked: { file: File; url: string } | null = null;
    const pickedBox = $('[data-thumb-picked]', form)!;
    const clearPicked = () => {
      if (picked) URL.revokeObjectURL(picked.url);
      picked = null;
      pickedBox.hidden = true;
    };
    const setPicked = (file: File, credit: string) => {
      clearPicked();
      picked = { file, url: URL.createObjectURL(file) };
      $<HTMLImageElement>('[data-picked-img]', pickedBox)!.src = picked.url;
      $('[data-picked-credit]', pickedBox)!.textContent = credit;
      pickedBox.hidden = false;
      field('thumb').value = '';
      thumbRemove.checked = false;
    };
    $('[data-picked-clear]', form)!.addEventListener('click', clearPicked);
    field('thumb').addEventListener('change', () => field('thumb').files?.length && clearPicked());
    let autoAlt = ''; // 명화를 고를 때 자동으로 채운 썸네일 설명 (직접 고쳤으면 건드리지 않는다)
    setupArtPicker((file, info) => {
      setPicked(file, `${info.title}${info.artist ? ` — ${info.artist}` : ''}${info.date ? `, ${info.date}` : ''} · ${info.museum} (퍼블릭 도메인)`);
      const alt = field('thumbnailAlt');
      if (!alt.value.trim() || alt.value === autoAlt) {
        autoAlt = `${info.title}${info.artist ? `, ${info.artist}` : ''} (${info.museum} 소장, 퍼블릭 도메인)`;
        alt.value = autoAlt;
      }
    });

    // ── 미리보기 ──
    const pvDialog = $<HTMLDialogElement>('[data-preview]')!;
    const fileUrls: string[] = [];
    const urlOf = (f: File) => {
      const u = URL.createObjectURL(f);
      fileUrls.push(u);
      return u;
    };
    pvDialog.addEventListener('close', () => fileUrls.splice(0).forEach((u) => URL.revokeObjectURL(u)));
    $('[data-preview-open]', form)!.addEventListener('click', () => {
      const fd = new FormData(form);
      const list = (v: FormDataEntryValue | null) => String(v ?? '').split(',').map((t) => t.trim()).filter(Boolean);
      const chosen = fd.get('thumb') as File | null;
      const thumbUrl =
        chosen && chosen.size ? urlOf(chosen) : picked ? picked.url : editing && loaded?.thumbnail && !thumbRemove.checked ? loaded.thumbnail.url : null;
      const md = editing && loaded?.mode === 'markdown';
      renderPreview($('[data-preview-body]')!, {
        kind: kindOf(),
        title: String(fd.get('title') ?? '').trim(),
        subtitle: String(fd.get('subtitle') ?? '').trim(),
        date: String(fd.get('date') || new Date().toISOString().slice(0, 10)),
        period: String(fd.get('period') ?? '').trim(),
        summary: String(fd.get('summary') ?? '').trim(),
        tags: list(fd.get('tags')),
        role: String(fd.get('role') ?? '').trim(),
        tools: list(fd.get('tools')),
        thumbUrl,
        thumbAlt: String(fd.get('thumbnailAlt') ?? ''),
        images: gallery.map((g) => ({ url: g.url, size: g.size })),
        bodyHtml: md ? markdownToHtml(mdArea.value, loaded?.assetPrefix) : rich.isEmpty() ? '' : `<div class="rich">${rich.editor.getHTML()}</div>`,
      });
      pvDialog.showModal();
    });
    const load = async () => {
      if (!editing) return;
      submitBtn.disabled = true;
      try {
        const d = (await api(`/api/admin/posts?kind=${editKind}&slug=${editSlug}`, { method: 'GET' })) as Loaded;
        loaded = d;
        const set = (name: string, v: string) => field(name) && (field(name).value = v);
        set('title', d.title);
        set('subtitle', d.subtitle);
        set('date', d.date);
        set('period', d.period);
        set('summary', d.summary);
        set('tags', d.tags.join(', '));
        set('role', d.role);
        set('tools', d.tools.join(', '));
        set('thumbnailAlt', d.thumbnailAlt);
        field('thumb').value = '';
        clearPicked();
        thumbRemove.checked = false;
        thumbNow.hidden = !d.thumbnail;
        if (d.thumbnail) $<HTMLImageElement>('[data-thumb-img]', thumbNow)!.src = d.thumbnail.url;
        gallery = d.images.map((i) => ({ keep: i.path, url: i.url, size: i.size }));
        renderGallery();
        const md = d.mode === 'markdown';
        mdBox.hidden = !md;
        $('[data-editor-box]', form)!.hidden = md;
        $('[data-editor-hint]', form)!.hidden = md;
        if (md) mdArea.value = d.body;
        else rich.setHTML(d.body);
        status.textContent = '';
        submitBtn.disabled = false;
      } catch (err) {
        status.textContent = (err as Error).message;
      }
    };
    void load();

    $('[data-edit-delete]', form)?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      if (!confirm(`「${field('title').value}」을(를) 지울까요? 이미지도 함께 지워지고 되돌릴 수 없어요.`)) return;
      b.disabled = true;
      status.textContent = '지우는 중…';
      try {
        await api('/api/admin/posts', { method: 'DELETE', body: JSON.stringify({ kind: editKind, slug: editSlug }) });
        status.textContent = '지웠어요. 1–2분 뒤 사이트에서 사라져요.';
        setTimeout(() => (location.href = '/admin#posts'), 1200);
      } catch (err) {
        status.textContent = (err as Error).message;
        b.disabled = false;
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (editing && !loaded) return;
      const fd = new FormData(form);
      const title = String(fd.get('title') ?? '').trim();
      if (!title) return void ((status.textContent = '제목을 적어 주세요.'), $<HTMLInputElement>('#u-title', form)!.focus());
      let slug = editSlug ?? String(fd.get('slug') ?? '').trim();
      if (slug && !/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) return void (status.textContent = '주소 이름은 영문 소문자·숫자·하이픈만 쓸 수 있어요.');
      // 본문 그림 경로를 정하려면 주소 이름이 먼저 필요하다: 비어 있으면 날짜-임의문자
      if (!slug) slug = `${String(fd.get('date') || new Date().toISOString().slice(0, 10)).replaceAll('-', '')}-${Math.random().toString(16).slice(2, 6)}`;
      const kind = kindOf();

      submitBtn.disabled = true;
      try {
        const upload = async (file: File, maxW: number) =>
          api('/api/admin/blob', { method: 'POST', body: JSON.stringify({ data: await shrink(file, maxW) }) }) as Promise<{ sha: string; ext: string }>;

        const chosen = fd.get('thumb') as File | null;
        const thumbFile = chosen && chosen.size ? chosen : (picked?.file ?? null);
        let thumbnail: { sha: string; ext: string } | null | undefined;
        if (thumbFile && thumbFile.size) {
          status.textContent = '썸네일 올리는 중…';
          thumbnail = await upload(thumbFile, 1600);
        } else if (editing && thumbRemove.checked) thumbnail = null;

        const newCount = gallery.filter((g) => 'file' in g).length;
        let done = 0;
        const images: (({ keep: string } | { sha: string; ext: string }) & { size: Size })[] = [];
        for (const g of gallery) {
          if ('keep' in g) images.push({ keep: g.keep, size: g.size });
          else {
            status.textContent = `이미지 올리는 중… (${++done}/${newCount})`;
            images.push({ ...(await upload(g.file, 2000)), size: g.size });
          }
        }

        let bodyHtml = '';
        let body = '';
        const bodyImages: { name: string; sha: string }[] = [];
        const markdownMode = editing && loaded?.mode === 'markdown';
        if (markdownMode) body = mdArea.value;
        else {
          // 본문 속 새 그림: 문서 순서대로 올리고 임시 주소를 실제 경로로 바꾼다. 번호는 이미 있는 그림 뒤부터
          const used = (loaded?.uploads ?? []).map((n) => Number(n.match(/^b(\d+)\./)?.[1] ?? 0));
          let next = Math.max(0, ...used) + 1;
          const inBody = rich.collectImages();
          const map = new Map<string, string>();
          if (loaded) map.set(loaded.previewPrefix, loaded.uploadPrefix);
          for (const [i, it] of inBody.entries()) {
            status.textContent = `본문 그림 올리는 중… (${i + 1}/${inBody.length})`;
            const up = await upload(it.file, 2000);
            const name = `b${String(next++).padStart(2, '0')}.${up.ext}`;
            bodyImages.push({ name, sha: up.sha });
            map.set(it.src, `/uploads/${kind}/${slug}/${name}`);
          }
          bodyHtml = rich.isEmpty() ? '' : rich.htmlWith(map);
        }

        status.textContent = '글 저장하는 중…';
        const res = await api('/api/admin/posts', {
          method: editing ? 'PUT' : 'POST',
          body: JSON.stringify({
            kind,
            title,
            subtitle: fd.get('subtitle'),
            date: fd.get('date'),
            period: fd.get('period'),
            summary: fd.get('summary'),
            tags: fd.get('tags'),
            slug,
            role: fd.get('role'),
            tools: fd.get('tools'),
            thumbnailAlt: fd.get('thumbnailAlt'),
            mode: markdownMode ? 'markdown' : 'rich',
            body,
            bodyHtml,
            bodyImages,
            thumbnail,
            images,
          }),
        });
        const link = Object.assign(document.createElement('a'), { href: res.url, textContent: res.url });
        if (editing) {
          await load();
          status.replaceChildren('저장했어요! 1–2분 뒤 사이트에 반영돼요 → ', link);
        } else {
          form.reset();
          rich.clear();
          gallery = [];
          clearPicked();
          renderGallery();
          syncKind();
          const edit = Object.assign(document.createElement('a'), { href: `/admin?edit=${kind}/${slug}`, textContent: '다시 고치기' });
          status.replaceChildren('올렸어요! 1–2분 뒤 사이트에 나타나요 → ', link, ' · ', edit);
        }
      } catch (err) {
        status.textContent = (err as Error).message;
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  /** 명화 검색 창: 고르면 가운데를 3:2 로 잘라(가로 최대 1200px, 늘리지 않음) 파일로 넘긴다 */
  type ArtInfo = { source: string; id: string; title: string; artist: string; date: string; museum: string; thumb: string; link: string };
  function setupArtPicker(onPick: (file: File, info: ArtInfo) => void) {
    const dlg = $<HTMLDialogElement>('[data-art]');
    const openBtn = $('[data-art-open]');
    if (!dlg || !openBtn) return;
    const status = $('[data-art-status]', dlg)!;
    const grid = $('[data-art-results]', dlg)!;
    const input = $<HTMLInputElement>('#art-q', dlg)!;
    openBtn.addEventListener('click', () => {
      dlg.showModal();
      input.focus();
    });

    const crop = async (blob: Blob) => {
      const bmp = await createImageBitmap(blob);
      let sw = bmp.width;
      let sh = Math.round((sw * 2) / 3);
      if (sh > bmp.height) {
        sh = bmp.height;
        sw = Math.round((sh * 3) / 2);
      }
      const w = Math.min(1200, sw);
      const c = Object.assign(document.createElement('canvas'), { width: w, height: Math.round((w * 2) / 3) });
      const ctx = c.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(bmp, Math.round((bmp.width - sw) / 2), Math.round((bmp.height - sh) / 2), sw, sh, 0, 0, c.width, c.height);
      const out = await new Promise<Blob | null>((ok) => c.toBlob(ok, 'image/webp', 0.92));
      const fallback = out && out.type === 'image/webp' ? out : await new Promise<Blob | null>((ok) => c.toBlob(ok, 'image/jpeg', 0.92));
      if (!fallback) throw new Error('그림을 자르지 못했어요.');
      return new File([fallback], `art-thumb.${fallback.type === 'image/webp' ? 'webp' : 'jpg'}`, { type: fallback.type });
    };

    const pick = async (a: ArtInfo, btn: HTMLButtonElement) => {
      btn.disabled = true;
      status.textContent = `「${a.title}」 가져오는 중…`;
      try {
        const res = await fetch('/api/admin/art', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ source: a.source, id: a.id }) });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `가져오지 못했어요 (${res.status})`);
        onPick(await crop(await res.blob()), a);
        status.textContent = '';
        dlg.close();
      } catch (err) {
        status.textContent = (err as Error).message;
      } finally {
        btn.disabled = false;
      }
    };

    $<HTMLFormElement>('[data-art-form]', dlg)!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      status.textContent = '찾는 중…';
      grid.replaceChildren();
      try {
        const { results } = (await api(`/api/admin/art?q=${encodeURIComponent(q)}`, { method: 'GET' })) as { results: ArtInfo[] };
        status.textContent = results.length ? `${results.length}개 · 그림을 누르면 썸네일로 넣어요` : '찾은 작품이 없어요. 다른 영어 단어로 찾아 보세요.';
        grid.replaceChildren(
          ...results.map((a) => {
            const li = document.createElement('li');
            const b = Object.assign(document.createElement('button'), { type: 'button', className: 'art-item' });
            b.setAttribute('aria-label', `${a.title} 썸네일로 쓰기`);
            const im = Object.assign(document.createElement('img'), { src: a.thumb, alt: '', loading: 'lazy' });
            im.addEventListener('error', () => li.remove());
            const t = Object.assign(document.createElement('span'), { className: 'art-title', textContent: a.title });
            const m = Object.assign(document.createElement('span'), { className: 'art-meta', textContent: [a.artist, a.date].filter(Boolean).join(', ') });
            b.append(im, t, m);
            b.addEventListener('click', () => pick(a, b));
            const link = Object.assign(document.createElement('a'), { href: a.link, target: '_blank', rel: 'noopener noreferrer', className: 'art-link', textContent: `${a.museum} ↗` });
            li.append(b, link);
            return li;
          }),
        );
      } catch (err) {
        status.textContent = (err as Error).message;
      }
    });
  }

