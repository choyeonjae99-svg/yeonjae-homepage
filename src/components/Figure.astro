---
/*
 * 글 아래 그림 모음 · 그림 작업물 이미지.
 * - 원본 크기로 보일 때는 다시 압축하지 않은 원본 파일을 그대로 쓴다 (글자·선이 흐려지지 않게)
 * - 더 작은 화면용으로만 가벼운 WebP 사본을 만든다 (원본보다 큰 사본은 만들지 않는다)
 * - 크기: 원본 / 작게 40% / 중간 70% / 꽉 차게 (본문 그림과 같은 규칙, 원본보다 크게 늘리지 않음)
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IMAGE_QUALITY, type ImageSize } from '../data/images';

interface Props {
  img: ImageMetadata;
  alt: string;
  size?: ImageSize;
  /** 이 그림이 놓이는 칸의 최대 가로(px) */
  maxWidth: number;
  loading?: 'lazy' | 'eager';
}

const { img, alt, size = 'original', maxWidth, loading = 'lazy' } = Astro.props;
const frac = { original: 1, small: 0.4, medium: 0.7, full: 1 }[size];
const smaller = [640, 1000, 1600].filter((w) => w < img.width * 0.85);
const variants = await Promise.all(smaller.map((w) => getImage({ src: img, width: w, format: 'webp', quality: IMAGE_QUALITY })));
const srcset = [...variants.map((v, i) => `${v.src} ${smaller[i]}w`), `${img.src} ${img.width}w`].join(', ');
const sizes = `min(calc((100vw - 48px) * ${frac}), ${Math.round(maxWidth * frac)}px, ${img.width}px)`;
---

<img
  class="fig"
  src={img.src}
  srcset={srcset}
  sizes={sizes}
  width={img.width}
  height={img.height}
  alt={alt}
  loading={loading}
  decoding="async"
  data-size={size}
  style={`max-width:${img.width}px`}
/>

<style>
  .fig {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--color-border);
  }
  .fig[data-size='small'] {
    width: 40%;
  }
  .fig[data-size='medium'] {
    width: 70%;
  }
  .fig[data-size='full'] {
    width: 100%;
  }
  @media (max-width: 640px) {
    .fig[data-size='small'] {
      width: 70%;
    }
    .fig[data-size='medium'] {
      width: 100%;
    }
  }
</style>
