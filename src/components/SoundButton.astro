---
/*
 * 사운드 버튼 — 배경음악(YouTube) 켜고 끄기. 재생 로직은 src/scripts/music.ts
 * transition:persist 로 페이지를 이동해도 같은 버튼(과 상태)이 유지된다.
 */
---

<button
  class="snd"
  id="sound-toggle"
  type="button"
  aria-pressed="false"
  aria-label="배경음악 켜고 끄기"
  data-state="idle"
  transition:persist="sound-toggle"
>
  <span class="eq" aria-hidden="true">
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
  </span>
  <span class="label" data-label>SOUND OFF</span>
</button>

<script>
  import { music } from '../scripts/music';
  import { MUSIC } from '../data/site';

  const LABELS = {
    idle: 'SOUND OFF',
    paused: 'SOUND OFF',
    loading: 'LOADING',
    playing: 'SOUND ON',
    error: 'NO SOUND',
  } as const;

  music.configure(MUSIC.youtubeId, MUSIC.volume);

  // 이 스크립트는 한 번만 실행되고, 버튼은 persist 되므로 리스너도 유지된다.
  const btn = document.getElementById('sound-toggle');
  if (btn && !btn.dataset.ready) {
    btn.dataset.ready = 'true';
    const label = btn.querySelector('[data-label]');

    const render = () => {
      btn.dataset.state = music.state;
      btn.setAttribute('aria-pressed', String(music.on));
      if (label) label.textContent = LABELS[music.state];
      if (music.state === 'error') btn.setAttribute('aria-label', '배경음악을 불러오지 못했습니다');
    };

    btn.addEventListener('click', () => music.toggle());
    music.addEventListener('change', render);
    render();

    // 버튼을 누르는 순간 바로 재생되도록 플레이어를 미리 준비한다 (소리는 나지 않는다)
    const warm = () => void music.prepare();
    const idle = window.requestIdleCallback ?? ((fn: () => void) => window.setTimeout(fn, 1500));
    if (document.readyState === 'complete') idle(warm);
    else window.addEventListener('load', () => idle(warm), { once: true });
    btn.addEventListener('pointerenter', warm, { once: true });
    btn.addEventListener('focus', warm, { once: true });
  }
</script>

<style>
  .snd {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap-min);
    padding: 0 var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-pixel);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--step-fast);
  }
  .snd:hover,
  .snd[aria-pressed='true'] {
    color: var(--color-text);
  }
  .snd[data-state='error'] {
    color: var(--color-dot);
    cursor: default;
  }
  /* 불러오는 중: 바가 차례로 깜빡인다 */
  .snd[data-state='loading'] .bar {
    animation: blink 0.6s steps(2) infinite;
  }
  .snd[data-state='loading'] .bar:nth-child(2) {
    animation-delay: 0.2s;
  }
  .snd[data-state='loading'] .bar:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes blink {
    50% { opacity: 0.2; }
  }
  .eq {
    display: flex;
    gap: 2px;
    align-items: flex-end;
    height: 12px;
  }
  .bar {
    display: block;
    width: 3px;
    height: 12px;
    background: var(--color-accent);
    transform-origin: bottom;
    transform: scaleY(0.25);
  }
  .snd[data-state='playing'] .bar {
    animation: eq 0.8s var(--step-fast) infinite alternate;
  }
  .snd[data-state='playing'] .bar:nth-child(2) {
    animation-delay: 0.25s;
  }
  .snd[data-state='playing'] .bar:nth-child(3) {
    animation-delay: 0.5s;
  }
  @keyframes eq {
    from { transform: scaleY(0.25); }
    to { transform: scaleY(1); }
  }
</style>
