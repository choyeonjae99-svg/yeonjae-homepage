---
/*
 * 주인 전용 추가 카드. 방문자에게는 숨겨져 있고,
 * /admin 에서 로그인한 브라우저에서만 보인다. 링크는 관리자 페이지의 올리기 화면으로 간다.
 */
interface Step {
  label: string;
  href: string;
  note?: string;
}
interface Props {
  title: string;
  steps: Step[];
  hint?: string;
  as?: 'li' | 'div';
}

const { title, steps, hint = '올리면 1–2분 뒤 사이트에 나타나요.', as: Tag = 'li' } = Astro.props;
---

<Tag class="owner-add" data-owner-only hidden>
  <div class="card">
    <span class="plus" aria-hidden="true"></span>
    <p>{title}</p>
    <ol class="caption steps">
      {steps.map((s) => (
        <li>
          <a href={s.href}>{s.label}</a>
          {s.note && <span>{s.note}</span>}
        </li>
      ))}
    </ol>
    <p class="hint">{hint}</p>
  </div>
</Tag>

<style>
  .owner-add {
    list-style: none;
    min-width: 0;
  }
  .owner-add[hidden] {
    display: none;
  }
  .card {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-3);
    height: 100%;
    min-height: 280px;
    padding: var(--space-5);
    border: 2px dashed var(--color-dot);
  }
  .plus {
    position: relative;
    width: 16px;
    height: 16px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    background: var(--color-accent);
  }
  .plus::before {
    left: 6px;
    top: 0;
    width: 4px;
    height: 16px;
  }
  .plus::after {
    left: 0;
    top: 6px;
    width: 16px;
    height: 4px;
  }
  .steps {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-1);
  }
  .steps li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3);
  }
  .steps a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .steps a:hover {
    color: var(--color-text);
  }
  .hint {
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
