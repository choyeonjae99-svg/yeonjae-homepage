---
import { SITE } from '../data/site';

interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'page' } = Astro.props;
const year = new Date().getFullYear();
---

{/* 메인 화면에는 푸터를 두지 않는다 (예전 SCROLL 표시는 주인 요청으로 뺐다) */}
{variant === 'page' && (
  <footer class="site-footer page" data-footer>
    <span class="caption">© {year} {SITE.name}</span>
    <a class="caption mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a class="pixel-label top" href="#top">Top</a>
  </footer>
)}

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .site-footer.page {
    flex-wrap: wrap;
    margin: var(--space-9) var(--gutter) 0;
    padding: var(--space-5) 0 var(--edge-bottom);
    border-top: 1px dashed var(--color-border);
  }
  .top {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    transition: color var(--dur-fast) var(--step-fast);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    transition: color var(--dur-fast) var(--step-fast);
  }
  .mail:hover {
    color: var(--color-accent-light);
  }
  .top:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .site-footer.page {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
